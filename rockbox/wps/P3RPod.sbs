%Vf(546ec2)
%al  %mh
%al  %mh
%al  %mh
%Vf(516fbe)
%al  %mh
%al  %mh
%al  %mh
%Vf(4a60a5)
%al  %mh
%al  %mh
%Vf(485a8c)
%al  %mh
%al    %mh
%Vf(dae6fe)
%al  %mh
%al%mh

#__Clock
%Vl(LockScreen,115,135,200,30,6)
%ac%cH:%cM:%cS
# %alLOCKED

#__Calendar
%Vl(LockScreen,115,166,200,20,3)
%ac%ca.%, %cb. %ce